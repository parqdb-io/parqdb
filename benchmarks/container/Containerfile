FROM python:3.12.13-slim-bookworm

ARG RUST_VERSION=1.96.0
ARG BENCHMARK_REVISION=unknown

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        build-essential \
        ca-certificates \
        clang \
        cmake \
        curl \
        git \
        pkg-config \
    && rm -rf /var/lib/apt/lists/* \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain "${RUST_VERSION}" \
    && python -m pip install --no-cache-dir \
        cloudpickle==3.1.1 \
        faiss-cpu==1.14.3 \
        h5py==3.15.1 \
        maturin==1.14.1 \
        numpy==2.5.1 \
        pyarrow==25.0.0

ENV PATH="/root/.cargo/bin:${PATH}"
ENV RELIFY_BENCHMARK_REVISION=${BENCHMARK_REVISION}

COPY benchmarks /opt/relify/benchmarks
COPY benchmarks/container/entrypoint.sh /usr/local/bin/run-relify-benchmark
COPY benchmarks/container/relify/run.sh /usr/local/bin/run-relify
COPY benchmarks/container/faiss/run.sh /usr/local/bin/run-faiss

RUN chmod 0755 \
        /usr/local/bin/run-relify-benchmark \
        /usr/local/bin/run-relify \
        /usr/local/bin/run-faiss

WORKDIR /opt/relify

ENTRYPOINT ["/usr/local/bin/run-relify-benchmark"]
